{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:defuss:tauri:configuration:v2",
  "title": "defuss-tauri URL/folder configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "appName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\:*?\"<>|\\u0000-\\u001f\\u007f]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9-]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "rustTarget": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_]+(?:-[a-zA-Z0-9_]+){2,}$"
    },
    "managedDirName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "tauriOutDir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "platform": {
      "enum": [
        "native",
        "macos",
        "windows",
        "linux",
        "ios",
        "android"
      ]
    },
    "security": {
      "enum": [
        "developer",
        "strict"
      ],
      "default": "developer",
      "description": "Developer enables the native inspector. Neither value overrides target TLS, CORS, OS permissions or engine feature availability."
    },
    "icons": {
      "type": "array",
      "description": "App icon files (.png, .ico, .icns), relative to this configuration file; copied into the generated host and used for bundling.",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/|\\\\|[A-Za-z]:).+$"
      }
    },
    "rust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "type": "array",
          "description": "Opt-in user Rust crates compiled into the generated host; nothing ships unless listed here.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "package"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/|\\\\|[A-Za-z]:).+$",
                "description": "Directory of the extension crate, relative to this configuration file."
              },
              "package": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
                "description": "Package name of the crate as written in its Cargo.toml."
              },
              "capabilities": {
                "type": "array",
                "description": "Tauri v2 capability objects; each is rendered verbatim into src-tauri/capabilities/.",
                "items": {
                  "type": "object",
                  "required": ["identifier", "windows", "permissions"],
                  "properties": {
                    "identifier": { "type": "string", "minLength": 1 },
                    "windows": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "permissions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "resizable": {
          "type": "boolean"
        },
        "fullscreen": {
          "type": "boolean"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "spa": {
          "type": "boolean",
          "default": false
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "description": "Exact relative path prefixes, not globs. May include deliberate browser assets from excluded directories. Secrets remain excluded."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[!#$%&'*+.^_`|~0-9a-zA-Z-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[\\t\\x20-\\x7e]*$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "entry"
          ]
        },
        "properties": {
          "assets": {
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
