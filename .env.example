# Environment keys the defuss-tauri CLI and generated host read. No secrets belong here.
# The CLI reads the shell environment; nothing loads this file automatically.

# Android builds (--platform android): SDK and NDK locations. ANDROID_SDK_ROOT is the legacy SDK name.
ANDROID_HOME=
ANDROID_SDK_ROOT=
NDK_HOME=

# Set only by tools/native.py for probe-feature binaries; leave empty for normal builds.
DEFUSS_TAURI_PROBE_OUTPUT=
DEFUSS_TAURI_PROBE_RUN_ID=
